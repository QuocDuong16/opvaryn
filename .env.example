# ─── Ports ────────────────────────────────────────────────────────────────────
# OPVARYN uses the 21xxx range to avoid collisions with other local projects.
WEB_PORT=21500
API_PORT=21501
POSTGRES_PORT=21532

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=opvaryn
POSTGRES_PASSWORD=opvaryn
POSTGRES_DB=opvaryn
# Used when running the Go binaries directly (outside Docker Compose).
DATABASE_URL=postgres://opvaryn:opvaryn@localhost:21532/opvaryn?sslmode=disable

# ─── API ──────────────────────────────────────────────────────────────────────
API_ENV=development
API_LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:21500

# ─── Web ──────────────────────────────────────────────────────────────────────
# Server-side API base URL used by Server Components and Server Actions; takes
# precedence over the public value below and is never shipped to the browser.
API_BASE_URL=http://localhost:21501
# Baked into the browser bundle; never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:21501

# ─── Outbound webhook (ADR 0012) ──────────────────────────────────────────────
# Where engine events are announced (instance started, task created, instance
# finished/rejected). Leave the URL empty to keep the integration off: nothing is
# queued and nothing is sent.
# OPVARYN_WEBHOOK_URL=https://vi-du.congty.local/opvaryn/hooks
# Shared secret for the HMAC signature; the receiver verifies X-OPVARYN-Signature.
# OPVARYN_WEBHOOK_SECRET=doi-secret-nay-truoc-khi-dung
# How long one POST may take, and how many attempts before a delivery is given up on.
# OPVARYN_WEBHOOK_TIMEOUT=5s
# OPVARYN_WEBHOOK_MAX_ATTEMPTS=5

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ─── Deployment (one internal host, ADR 0009) ─────────────────────────────────
# Hostname the pilot stack answers on; Caddy issues a certificate for it from its
# own CA (`tls internal` in deployments/caddy/Caddyfile).
OPVARYN_HOSTNAME=opvaryn.local
# Caddy's published ports. The defaults stay inside the documented 21xxx range so this
# stack cannot collide with anything else on a shared machine. On a dedicated internal
# host set CADDY_HTTP_PORT=80 and CADDY_HTTPS_PORT=443 so users can leave the port out
# of the URL.
CADDY_HTTP_PORT=21580
CADDY_HTTPS_PORT=21443
# With HTTPS in front (Caddy), set this to production so session cookies are marked
# Secure. Leave it on development only when the stack is served over plain HTTP.
# API_ENV=production
# Browser-facing origin, i.e. https://<OPVARYN_HOSTNAME>
# CORS_ALLOWED_ORIGINS=https://opvaryn.local
# Where the backup job writes its dumps. Point this at a second disk or a synced
# directory: a dump that only ever lives beside the database is not a backup.
# Copy this file to `.env` on the host and change POSTGRES_PASSWORD there.
BACKUP_DIR=./deployments/backups
# How many dumps to keep (oldest are pruned after a successful run).
BACKUP_KEEP=14
# Seconds between backup runs (default: daily).
BACKUP_INTERVAL_SECONDS=86400
# Image tags the compose file builds and runs; override when pushing to a registry.
# OPVARYN_API_IMAGE=opvaryn-api:local
# OPVARYN_WEB_IMAGE=opvaryn-web:local
